# 이 파일을 .env 로 복사한 뒤 본인 값으로 채운다. (.env 는 .gitignore 대상)
#   cp .env.example .env
#
# ⚠️ MYSQL_PASSWORD 는 아래 두 곳과 반드시 같은 값이어야 한다.
#    - db/00_init_local_db.sql          (로컬 MySQL 에 계정을 만들 때)
#    - apps/api/.../application-local.properties (백엔드가 접속할 때)

# === MySQL ===
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=tangtang
MYSQL_USER=tangtang
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# === 인증 (JWT · 구글 OAuth) ===
# JWT_SECRET 은 HS256 이라 32자 이상이어야 한다.
#   PowerShell: $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# === 배포 환경 주소 (docker compose 로 띄울 때만 사용) ===
# Vercel 프론트 주소. 구글 콜백 후 사용자를 되돌려보낼 곳이다.
APP_FRONT_URL=https://monorepo-three-ruby-81.vercel.app
# 구글 콘솔의 "승인된 리디렉션 URI" 와 문자 하나까지 같아야 한다.
GOOGLE_OAUTH_REDIRECT_URI=https://monorepo-three-ruby-81.vercel.app/api/auth/google/callback
# Vercel 은 HTTPS 라 true. 로컬에서 docker compose 를 http://localhost 로 띄워 쓸 때는 false 로 둔다
# (Secure 쿠키는 HTTPS 에서만 저장되므로 http 로 접속하면 로그인이 유지되지 않는다).
AUTH_COOKIE_SECURE=true

# === CODEF API (실제 자산 연동) ===
CODEF_API_URL=https://api.codef.io
CODEF_CLIENT_ID=여기에_클라이언트ID_입력
CODEF_CLIENT_SECRET=여기에_클라이언트시크릿_입력

# v1 은 컨테이너 볼륨(uploads)에 저장한다. 아래 S3 값은 S3ImageStorage 를 붙인 뒤에만 쓰인다.
# === AWS S3 (이미지 업로드) ===
AWS_ACCESS_KEY_ID=여기에_액세스키_입력
AWS_SECRET_ACCESS_KEY=여기에_시크릿키_입력
AWS_S3_BUCKET=여기에_버킷이름_입력
AWS_REGION=ap-northeast-2