# 이 파일을 .env 로 복사한 뒤 본인 값으로 채운다. (.env 는 .gitignore 대상)
#   cp .env.example .env
#
# ⚠️ MYSQL_PASSWORD 는 아래 두 곳과 반드시 같은 값이어야 한다.
#    - db/00_init_local_db.sql          (로컬 MySQL 에 계정을 만들 때)
#    - apps/api/.../application-local.properties (백엔드가 접속할 때)

# === MySQL ===
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=tangtang
MYSQL_USER=tangtang
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

# === CODEF API (실제 자산 연동) ===
CODEF_API_URL=https://api.codef.io
CODEF_CLIENT_ID=여기에_클라이언트ID_입력
CODEF_CLIENT_SECRET=여기에_클라이언트시크릿_입력

# === AWS S3 (이미지 업로드) ===
AWS_ACCESS_KEY_ID=여기에_액세스키_입력
AWS_SECRET_ACCESS_KEY=여기에_시크릿키_입력
AWS_S3_BUCKET=여기에_버킷이름_입력
AWS_REGION=ap-northeast-2