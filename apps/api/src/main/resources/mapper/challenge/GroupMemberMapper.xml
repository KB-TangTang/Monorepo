<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!--
  typeAliases 를 쓰지 않는 프로젝트다. resultType 은 FQCN 으로 쓴다.
  파라미터는 #{} 만 사용한다. ${} 는 SQL Injection 위험으로 금지.
-->
<mapper namespace="com.kb.tangtang.challenge.mapper.GroupMemberMapper">

    <!--
      lives_count 는 NOT NULL 이고 기본값이 없다. 평가 주기가 목숨 개수를 결정하므로
      서비스가 계산해 넣는다 (DAILY=기간 일수, PERIOD=1).
      final_* 3개는 종료 후 확정 배치가 채운다 — INSERT 시점에는 NULL 이다.
    -->
    <insert id="insertMember" parameterType="com.kb.tangtang.challenge.domain.GroupMember">
        INSERT INTO tbl_group_member (group_id, user_id, lives_count)
        VALUES (#{groupId}, #{userId}, #{livesCount})
    </insert>

    <!--
      닉네임은 표시용이라 조인해서 함께 읽는다. tbl_user.nickname 은 NULL 허용이다.
      정렬을 고정해야 프론트의 참여자 목록 순서가 요청마다 바뀌지 않는다.
    -->
    <select id="findByGroupIds" resultType="com.kb.tangtang.challenge.domain.GroupMember">
        SELECT m.group_id, m.user_id, m.lives_count,
               m.final_outcome, m.final_rank, m.final_charge_amount,
               u.nickname
        FROM tbl_group_member m
        JOIN tbl_user u ON u.id = m.user_id
        WHERE m.group_id IN
        <foreach collection="groupIds" item="groupId" open="(" separator="," close=")">
            #{groupId}
        </foreach>
        ORDER BY m.group_id, m.user_id
    </select>

    <!-- 채팅 참여자 캐시를 채울 때 쓴다. 캐시가 살아 있으면 호출되지 않는다 -->
    <select id="findUserIdsByGroupId" resultType="long">
        SELECT user_id
          FROM tbl_group_member
         WHERE group_id = #{groupId}
    </select>

    <!--
      유죄 확정 시 목숨 차감 (이슈 #172).

      ⚠ lives_count &gt; 0 이 음수 방어다. lives_count 는 UNSIGNED 가 아니라 그냥 INT 라
        조건이 없으면 -1 이 그대로 저장되고, 종료 후 확정 배치의 "lives_count = 0 이면 탈락"
        판정이 조용히 빗나간다.

      읽고 빼서 쓰지 않고 SQL 한 문장으로 깎는다 — 같은 사람의 재판 두 건이 같은 틱에
      확정되면 읽기-쓰기 사이가 겹친다.
    -->
    <update id="decreaseLife">
        UPDATE tbl_group_member
           SET lives_count = lives_count - 1
         WHERE group_id = #{groupId}
           AND user_id = #{userId}
           AND lives_count &gt; 0
    </update>

    <!--
      최종 결과 확정 (이슈 #172). JUDGING → CLOSED 배치만 호출한다.

      ⚠ final_outcome IS NULL 이 write-once 장치다. 빼면 배치를 다시 돌릴 때마다 값이 다시 쓰이고,
        그 사이 확정된 재판 때문에 이미 보여 준 순위가 뒤집힌다.

      세 컬럼을 한 문장으로 적는다 — 등수만 있고 판정이 빈 중간 상태를 화면이 읽으면 안 된다.
      updated_at 은 ON UPDATE CURRENT_TIMESTAMP 라 따로 쓰지 않는다.
    -->
    <update id="finalizeMember">
        UPDATE tbl_group_member
           SET final_outcome = #{finalOutcome},
               final_rank = #{finalRank},
               final_charge_amount = #{finalChargeAmount}
         WHERE group_id = #{groupId}
           AND user_id = #{userId}
           AND final_outcome IS NULL
    </update>
</mapper>
