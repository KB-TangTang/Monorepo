<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kb.tangtang.transaction.mapper.LlmCategorizationJobMapper">

    <insert id="insert" parameterType="com.kb.tangtang.transaction.domain.LlmCategorizationJob"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tbl_llm_categorization_job (user_id, status, transaction_count)
        VALUES (#{userId}, #{status}, #{transactionCount})
    </insert>

</mapper>
