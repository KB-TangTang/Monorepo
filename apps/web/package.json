{
    "name": "web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "format": "prettier --write \"src/**/*.{js,vue,css}\" \"*.{js,json,html}\"",
