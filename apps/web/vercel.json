{
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                { "key": "X-Frame-Options", "value": "DENY" },
                { "key": "X-Content-Type-Options", "value": "nosniff" },
                { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
            ]
        }
    ],
    "rewrites": [
        { "source": "/api/:path*", "destination": "https://kb-tangtang.duckdns.org/api/:path*" },
        { "source": "/uploads/:path*", "destination": "https://kb-tangtang.duckdns.org/uploads/:path*" },
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}
